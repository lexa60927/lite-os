{
  "name": "lite-craft",
  "private": true,
  "version": "0.4.2",
  "type": "module",
  "description": "LiteCraft — браузерный воксельный клон Minecraft на Three.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "render": "node dev/render-view.mjs",
    "render:tiles": "node dev/render-tiles.mjs /home/user/tiles-sheet.png",
    "test": "node --experimental-loader ./dev/loaders/css.mjs dev/smoke.mjs",
    "test:shaders": "node dev/test-shaders.cjs",
    "test:api": "node --experimental-loader ./dev/loaders/css.mjs dev/test-api.mjs",
    "test:calm": "node dev/test-calm.mjs",
    "test:uv": "node dev/test-uv.mjs",
    "test:stream": "node dev/test-stream.mjs",
    "test:net": "node --experimental-loader ./dev/loaders/css.mjs dev/test-net.mjs",
    "test:villages": "node --experimental-loader ./dev/loaders/css.mjs dev/test-villages.mjs",
    "test:mesh": "node dev/test-mesh.mjs",
    "test:textures": "node dev/test-textures.mjs",
    "test:world": "node dev/test-world.mjs",
    "test:physics": "node dev/test-physics.mjs",
    "bench:mesh": "node dev/bench-mesh.mjs",
    "net": "node dev/net-server.mjs",
    "test:render": "node --experimental-loader ./dev/loaders/css.mjs dev/test-render.mjs",
    "test:mods": "node --experimental-loader ./dev/loaders/css.mjs dev/test-mods.mjs"
  },
  "dependencies": {
    "three": "0.160.1"
  },
  "devDependencies": {
    "@shaderfrog/glsl-parser": "^7.0.1",
    "glsl-parser": "^2.0.1",
    "glsl-tokenizer": "^2.1.5",
    "vite": "5.4.11"
  }
}
