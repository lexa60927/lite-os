    "render": "node dev/render-view.mjs"
  },
  "dependencies": {
    "three": "0.160.1"
  },
  "devDependencies": {
    "glsl-parser": "^2.0.1",
    "glsl-tokenizer": "^2.1.5",
    "vite": "5.4.11"
  }
}
