{
  "name": "lite-craft",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LiteCraft — браузерный воксельный клон Minecraft на Three.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
